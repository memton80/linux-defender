# Rotation du journal de la protection en temps réel de Linux Defender.
@DEFENDER_ONACCESS_LOG@ {
    monthly
    rotate 6
    compress
    missingok
    notifempty
    # Copie puis vidage du fichier en place, plutôt que renommage et nouveau
    # fichier : clamonacc ignore SIGHUP et ne rouvre jamais son journal, il
    # écrirait sinon dans l'ancien fichier (compressé puis supprimé), et les
    # détections seraient perdues. Il l'a ouvert en ajout (O_APPEND) : après
    # le vidage, il écrit au début. Le fichier garde ses droits (0644,
    # lisible par l'application).
    copytruncate
}
