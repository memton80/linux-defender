#!/usr/bin/make -f
# Construction du paquet avec debhelper et CMake.

# Toutes les protections de Debian (pile, PIE, RELRO, fortify...) : c'est un antivirus.
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

include /usr/share/dpkg/pkg-info.mk

%:
	dh $@ --buildsystem=cmake

# Version affichée par l'application : celle du paquet, avec « - » au lieu de
# « ~ » (0.0.0~dev redevient 0.0.0-dev).
override_dh_auto_configure:
	dh_auto_configure -- -DDEFENDER_VERSION=$(subst ~,-,$(DEB_VERSION_UPSTREAM))

# Service de protection en temps réel : comportement par défaut de debhelper,
# activé et démarré à la première installation, redémarré après une mise à
# jour ; un service désactivé par l'administrateur le reste. La mise à jour
# depuis une version antérieure à 1.0.2 (service installé désactivé) est
# traitée dans postinst.
