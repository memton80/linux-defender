#!/bin/sh
set -e

SERVICE=linux-defender-onaccess.service

# Mise à jour depuis une version antérieure à 1.0.2 : le service y était
# installé désactivé d'office, et deb-systemd-helper a gardé cet état (il ne
# réactive jamais un service qu'il croit désactivé par l'administrateur). Cet
# état est oublié, puis le service est activé comme lors d'une première
# installation ; debhelper le démarre ensuite (plus bas).
if [ "$1" = "configure" ] && [ -n "$2" ] && dpkg --compare-versions "$2" lt 1.0.2; then
    deb-systemd-helper purge "$SERVICE" >/dev/null || true
    deb-systemd-helper enable "$SERVICE" >/dev/null || true
fi

# Première installation seulement : rappel des réglages nécessaires côté clamd.
if [ "$1" = "configure" ] && [ -z "$2" ]; then
    cat <<'MESSAGE'

Linux Defender est installé. Il a besoin du démon clamd (paquet clamav-daemon),
dont le socket est en général /run/clamav/clamd.ctl.
Si l'application signale « Permission refusée », ajoutez votre utilisateur au
groupe qu'elle indique (en général « clamav »), puis reconnectez-vous :
    sudo usermod -aG clamav $USER
La protection en temps réel (linux-defender-onaccess.service) est activée ;
pour la désactiver :
    sudo systemctl disable --now linux-defender-onaccess.service

MESSAGE
fi

#DEBHELPER#

exit 0
